rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function member(tripId) {
      return signedIn() && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }
    function inviteOk(tripId) {
      return request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.tripId == tripId;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['tripId', 'ownerUid', 'dest'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.tripId is string
        && request.resource.data.dest is string
        && request.resource.data.dest.size() < 80
        && exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId))
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow get: if member(tripId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.dest is string
        && request.resource.data.dest.size() < 80
        && request.resource.data.days is list
        && request.resource.data.days.size() < 400
        && (!('tasks' in request.resource.data) || (request.resource.data.tasks is list && request.resource.data.tasks.size() < 100));
      allow update: if member(tripId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.dest is string
        && request.resource.data.dest.size() < 80
        && request.resource.data.days is list
        && request.resource.data.days.size() < 400
        && (!('expenses' in request.resource.data) || (request.resource.data.expenses is list && request.resource.data.expenses.size() < 400))
        && (!('tasks' in request.resource.data) || (request.resource.data.tasks is list && request.resource.data.tasks.size() < 100));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || member(tripId));
        allow list: if member(tripId);
        allow create: if signedIn()
          && request.auth.uid == uid
          && inviteOk(tripId)
          && request.resource.data.keys().hasOnly(['name', 'photo', 'email', 'joinedAt', 'inviteCode'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 80
          && request.resource.data.photo is string
          && request.resource.data.photo.size() < 500
          && request.resource.data.email is string
          && request.resource.data.email.size() < 120
          && request.resource.data.joinedAt is number;
        allow update, delete: if false;
      }

      match /activity/{actId} {
        allow get, list: if member(tripId);
        allow create: if member(tripId)
          && request.resource.data.keys().hasOnly(['type', 'text', 'uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['join', 'expense', 'edit']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 200
          && request.resource.data.at is number;
        allow update, delete: if false;
      }
    }

    match /reviews/{id} {
      allow get, list: if true;
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.placeKey + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['uid', 'placeKey', 'placeName', 'date', 'stars', 'text', 'dishes', 'price', 'currency', 'photos', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.placeKey is string
        && request.resource.data.placeKey.size() > 0
        && request.resource.data.placeKey.size() < 40
        && request.resource.data.placeName is string
        && request.resource.data.placeName.size() < 90
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.stars is number
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.dishes is string
        && request.resource.data.dishes.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.currency is string
        && request.resource.data.currency.size() < 12
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 3
        && request.resource.data.at is number
        && !('email' in request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /backups/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'at', 'trips'])
        && request.resource.data.v == 1
        && request.resource.data.at is number
        && request.resource.data.trips is list
        && request.resource.data.trips.size() <= 40;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
